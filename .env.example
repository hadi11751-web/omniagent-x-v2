# OmniAgent X v2 environment configuration
#
# Copy this file to .env.local and fill in only the credentials you actually
# have.
#
# ALL provider API keys are server-side secrets.
# NEVER rename any of these to NEXT_PUBLIC_* variables (the publishable Clerk
# key below is the one exception - it is shipped to the browser by design).
# NEVER commit .env or .env.local.

# ---------------------------------------------------------------------------
# AUTHENTICATION (required - the app returns 401 without these)
# ---------------------------------------------------------------------------

# From the Clerk dashboard: API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# NEXUS - the one AI model (required)
# ---------------------------------------------------------------------------
#
# OmniAgent has exactly one model, Nexus. There is no model picker and no
# routing between models. The engine behind Nexus is whatever single
# OpenAI-compatible endpoint you point these variables at; users never see it.
#
# Examples:
#   OpenAI      NEXUS_BASE_URL=https://api.openai.com/v1            (default)
#   Groq        NEXUS_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  NEXUS_BASE_URL=https://openrouter.ai/api/v1
#   Local       NEXUS_BASE_URL=http://127.0.0.1:11434/v1   (Ollama, no key)
#
# 127.0.0.1 means the machine running this server, not the visitor's.

# The engine's model id, exactly as that endpoint names it. No default: there
# is no id that is valid on every endpoint.
NEXUS_MODEL=

# Endpoint root. Defaults to https://api.openai.com/v1 when empty.
NEXUS_BASE_URL=

# Bearer token for the endpoint. Not needed for a local endpoint.
NEXUS_API_KEY=

# Set to false if the engine above cannot read images (default true).
# Set true only when the configured Nexus model is confirmed to accept image input.
# Default is false for safety.
# NEXUS_VISION=true

# "local" or "cloud". Defaults to local for loopback hosts, cloud otherwise.
# It decides what a message that asks to be private may do, and what the app
# tells the user about where it was answered.
# NEXUS_EXECUTION=cloud

# Use the endpoint's native function-calling instead of the built-in text tool
# protocol. Off by default because the text protocol works on every endpoint.
# NEXUS_NATIVE_TOOLS=false

# ---------------------------------------------------------------------------
# TOOL BACKENDS (optional capabilities Nexus can call; none of these is a
# chat model and none is shown to users as one)
# ---------------------------------------------------------------------------

# Powers the generate_image tool.
GEMINI_API_KEY=

# Powers microphone transcription.
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# WEB SEARCH
# ---------------------------------------------------------------------------

# Preferred search provider.
TAVILY_API_KEY=

# Alternative search provider.
BRAVE_API_KEY=

# Without either key, OmniAgent may use its keyless fallback when supported.

# ---------------------------------------------------------------------------
# PERSISTENCE AND RATE LIMITS (Upstash Redis)
# ---------------------------------------------------------------------------

# Without these, conversations and memories stay in browser localStorage and the
# daily free-message quota, the per-user concurrency ceiling and the memory /
# transcription ceilings are counted per server instance instead of globally:
# still enforced, but a deployment with three instances gives one user three
# allowances. They never fail open.
#
# The in-process fallback recovers on its own: a concurrency slot carries the same
# expiry the Redis key gets, so a request that dies before releasing one cannot
# lock the account out of every model route.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# When "daily" rolls over. Minutes ahead of UTC (Pakistan is +300) or behind it;
# 0, the default, is UTC midnight. Changing it moves every existing counter to a
# fresh key, so set it once for the deployment rather than per user.
USAGE_DAY_OFFSET_MINUTES=0

# ---------------------------------------------------------------------------
# OUTBOUND FETCH (the fetch_url tool)
# ---------------------------------------------------------------------------

# Optional User-Agent for pages the agent reads. A crawler identifier usually
# carries a reachable contact URL; that URL belongs to whoever deploys this, so
# the default is the plain product token and the fuller form goes here.
# FETCH_USER_AGENT=OmniAgent/1.0 (+https://your-deployment.example)

# ---------------------------------------------------------------------------
# BILLING (Stripe - optional)
# ---------------------------------------------------------------------------

# Secret key for creating checkout sessions (sk_test_... in test mode).
STRIPE_SECRET_KEY=

# Price used by the "Upgrade" button.
STRIPE_PRICE_ID=

# Signing secret copied from the webhook endpoint (whsec_...). Needed to serve
# /api/stripe/webhook, which is what flips a user's plan to "paid".
STRIPE_WEBHOOK_SECRET=
