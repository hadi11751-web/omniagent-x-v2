# OmniAgent environment configuration
# Copy this file to .env.local and fill in the keys you actually have.
# Every key below is read ONLY on the server. Never prefix them with NEXT_PUBLIC_.

# --- Chat providers (at least one required) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# --- Local / on-device inference (optional) ---
# Base URL of an Ollama-compatible server. Requests stay on your machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Web search (optional, enables Research mode with real sources) ---
# Tavily (https://tavily.com) or Brave Search API. Without a key, research mode
# falls back to the DuckDuckGo HTML endpoint, which returns fewer results.
TAVILY_API_KEY=
BRAVE_API_KEY=
